datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  tasks        Task[]
  history      TaskHistory[]
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())

  isDone    Boolean  @default(false)
  doneAt    DateTime?

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model TaskHistory {
  id          Int      @id @default(autoincrement())
  title       String
  createdAt   DateTime
  completedAt DateTime
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}